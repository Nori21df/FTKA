{
  "name": "ftka-node-express-app",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js + Express.js migration of the existing FTKA Flask app.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:visual:update": "playwright test tests/visual.spec.ts --update-snapshots",
    "lint:templates": "node scripts/lint-templates.mjs",
    "test": "npm run lint:templates && npm run test:unit",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test tests/e2e.spec.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "compression": "^1.7.4",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.1",
    "sepay-pg-node": "^1.0.0",
    "socket.io": "^4.8.3",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "vitest": "^4.1.9"
  }
}
